# Copy this file to .env before running Docker Compose.
POSTGRES_DB=tripmate
POSTGRES_USER=tripmate
POSTGRES_PASSWORD=change_this_database_password

# Docker Compose overrides DATABASE_URL for the app service.
# For running Node directly on your computer, use localhost:
DATABASE_URL=postgresql://tripmate:change_this_database_password@localhost:5432/tripmate?schema=public

PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password
SESSION_SECRET=replace_this_with_a_long_random_secret
NODE_ENV=development
